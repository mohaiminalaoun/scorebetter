# Copy to backend/.env and fill in. Never commit the real .env.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Comma-separated. Anyone not listed here can never receive a sign-in link.
ALLOWED_EMAILS=

# Where the app lives. http://localhost:5173 in dev.
APP_URL=http://localhost:5173

# Leave unset in dev and magic links print to the backend console instead.
RESEND_API_KEY=
MAIL_FROM=ScoreBetter <onboarding@resend.dev>
